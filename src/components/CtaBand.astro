---
import { u } from '../lib/url';
import Icon from './Icon.astro';
import { company } from '../data/site';
interface Props { title?: string; text?: string }
const {
  title = 'Stückliste zur Hand?<br/><em>Wir rechnen.</em>',
  text = 'Schicken Sie uns Ihre Stückliste oder Projektdaten. Sie erhalten ein Angebot zu Projektkonditionen, mit geprüfter Kompatibilität und Alternativen.',
} = Astro.props;
---

<section class="cta-band">
  <div class="container">
    <div class="cta-card on-dark reveal">
      <img src={u("/img/sky.jpg")} alt="" loading="lazy" class="cta-bg" />
      <div class="cta-copy">
        <h2 class="h2" set:html={title} />
        <p class="lead">{text}</p>
      </div>
      <div class="cta-actions">
        <a href={u("/anfrage")} class="btn btn--sun">Projekt anfragen <span class="btn-icon"><Icon name="arrow-up-right" /></span></a>
        <a href={`tel:${company.phoneHref}`} class="btn btn--ghost">{company.phone} <span class="btn-icon"><Icon name="phone" /></span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { padding: clamp(64px, 9vw, 120px) 0 calc(var(--section) * 0.8); }
  .cta-card { position: relative; display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: end; padding: clamp(36px, 6vw, 72px); border-radius: 2.5rem; background: var(--navy); color: var(--white); overflow: hidden; isolation: isolate; }
  .cta-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.2; mix-blend-mode: luminosity; z-index: -1; }
  .cta-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(110deg, var(--navy) 30%, rgba(0, 0, 0, 0.4)); z-index: -1; }
  .cta-copy { display: grid; gap: 1.2rem; }
  .cta-copy .lead { color: rgba(255, 255, 255, 0.7); }
  .cta-card :global(.h2 em) { color: var(--sun-2); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; }
  @media (max-width: 900px) {
    .cta-card { grid-template-columns: 1fr; }
    .cta-actions { justify-content: flex-start; }
  }
</style>

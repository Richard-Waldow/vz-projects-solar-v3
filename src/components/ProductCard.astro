---
import { u } from '../lib/url';
import type { Product } from '../data/products';
import { categoryById } from '../data/products';
import { brandById } from '../data/brands';
import ProductArt from './ProductArt.astro';
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';

interface Props { product: Product; index?: number }
const { product: p, index = 0 } = Astro.props;
const brand = brandById[p.brand];
const href = u(`/produkte/${p.category}/${p.slug}`);
const variant = p.tags.includes('Full Black') ? 'black' : 'default';
const keySpecs = p.specs.slice(0, 3);
const search = [brand?.name, p.name, p.series, ...p.tags, categoryById[p.category].name].join(' ').toLowerCase();
---

<article
  class="pcard"
  data-product
  data-category={p.category}
  data-brand={p.brand}
  data-uses={p.uses.join('|')}
  data-search={search}
>
  <a href={href} class="pcard-media" aria-label={`${brand?.name} ${p.name}`}>
    <ProductArt category={p.category} variant={variant} seed={index} />
    <span class="pcard-logo"><BrandLogo id={p.brand} /></span>
  </a>
  <div class="pcard-body">
    <div class="pcard-tags">
      {p.tags.slice(0, 2).map((t) => <span class="chip">{t}</span>)}
    </div>
    <h3 class="pcard-title"><a href={href}><span class="pcard-brand">{brand?.name}</span>{p.name}</a></h3>
    <dl class="pcard-specs">
      {keySpecs.map(([k, v]) => (
        <div><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
    <div class="pcard-actions">
      <a href={href} class="link-arrow">Details <Icon name="arrow-right" /></a>
      <button
        type="button"
        class="pcard-add"
        data-add
        data-slug={p.slug}
        data-name={p.name}
        data-brand={brand?.name}
        data-category={categoryById[p.category].singular}
      >
        <span class="swap"><span>Anfragen</span><span>Auf der Liste</span></span>
        <span class="add-ico swap-ico"><Icon name="plus" /><Icon name="check" /></span>
      </button>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    padding: 6px;
    border-radius: var(--r-xl);
    background: rgba(0, 0, 0, 0.03);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.7s var(--ease), box-shadow 0.7s var(--ease);
  }
  .pcard:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px var(--line-2), 0 30px 60px -36px rgba(0, 0, 0, 0.35); }
  .pcard-media { position: relative; display: block; border-radius: calc(var(--r-xl) - 6px) calc(var(--r-xl) - 6px) 1rem 1rem; overflow: hidden; }
  .pcard-media :global(.art) { transition: transform 1.1s var(--ease); }
  .pcard:hover .pcard-media :global(.art) { transform: scale(1.04); }
  .pcard-logo {
    position: absolute;
    left: 12px;
    top: 12px;
    display: flex;
    align-items: center;
    height: 38px;
    max-width: 58%;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.3);
  }
  .pcard-logo :global(.blogo) { max-height: 20px; }
  .pcard-logo :global(.blogo-text) { font-size: 0.85rem; }
  .pcard-body { display: flex; flex-direction: column; gap: 0.9rem; flex: 1; padding: 18px 16px 14px; }
  .pcard-tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .pcard-title { margin: 0; font-family: var(--f-display); font-weight: 600; font-size: 1.42rem; line-height: 1.1; letter-spacing: -0.01em; }
  .pcard-brand { display: block; margin-bottom: 0.3rem; font-family: var(--f-ui); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .pcard-specs { margin: 0; display: grid; gap: 0.3rem; }
  .pcard-specs div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.42rem 0; border-top: 1px dashed var(--line-2); font-size: 0.8rem; }
  .pcard-specs dt { color: var(--muted); }
  .pcard-specs dd { margin: 0; font-family: var(--f-mono); font-size: 0.76rem; text-align: right; }
  .pcard-actions { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: auto; padding-top: 0.4rem; }
  .pcard-add {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 4px 4px 4px 14px;
    border: 0;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    font-size: 0.82rem;
    font-weight: 500;
    transition: background-color 0.5s var(--ease), transform 160ms var(--ease-ui);
  }
  .pcard-add:active { transform: scale(0.97); }
  .pcard-add:hover { background: var(--navy-2); }
  .add-ico { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(255, 255, 255, 0.14); transition: transform 0.6s var(--ease); }
  .add-ico :global(svg) { width: 14px; height: 14px; }
  .pcard-add:global(.is-added) { background: var(--sun-3); color: #5d410f; }
  .pcard-add:global(.is-added) .add-ico { background: rgba(0, 0, 0, 0.08); }
</style>

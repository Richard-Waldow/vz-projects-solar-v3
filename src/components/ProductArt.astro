---
// Einheitliche Produktillustrationen je Kategorie (statt uneinheitlicher Herstellerfotos)
import type { CategoryId } from '../data/products';
interface Props { category: CategoryId; variant?: 'black' | 'silver' | 'default'; seed?: number; class?: string; cover?: boolean }
const { category, variant = 'default', seed = 0, class: cls, cover = false } = Astro.props;
const id = `pa-${category}-${seed}`;
const panelFill = variant === 'black' ? '#141c28' : '#1f3456';
const frame = variant === 'black' ? '#0b1018' : '#c9ccd1';
const tilt = [-6, -4, -8, -5][seed % 4];
---

<svg class:list={['art', cls]} viewBox="0 0 400 300" preserveAspectRatio={cover ? 'xMidYMid slice' : 'xMidYMid meet'} aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fbfbfd" />
      <stop offset="1" stop-color="#ececf0" />
    </linearGradient>
    <radialGradient id={`${id}-sun`} cx="0.82" cy="0.12" r="0.6">
      <stop offset="0" stop-color="#dfe8f6" stop-opacity="0.7" />
      <stop offset="1" stop-color="#dfe8f6" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${id}-glass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.28" />
      <stop offset="0.45" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id={`${id}-metal`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#d8dde5" />
    </linearGradient>
    <pattern id={`${id}-cells`} width="22" height="18" patternUnits="userSpaceOnUse">
      <rect width="22" height="18" fill={panelFill} />
      <path d="M0 9h22M11 0v18" stroke={variant === 'black' ? '#1d2735' : '#2c4670'} stroke-width="0.8" />
      <rect x="0.5" y="0.5" width="21" height="17" fill="none" stroke={variant === 'black' ? '#0e141d' : '#18294a'} stroke-width="1" />
    </pattern>
  </defs>
  <rect width="400" height="300" fill={`url(#${id}-bg)`} />
  <rect width="400" height="300" fill={`url(#${id}-sun)`} />
  <ellipse cx="200" cy="262" rx="140" ry="14" fill="#0e1a2c" opacity="0.08" />

  {category === 'module' && (
    <g transform={`translate(200 150) rotate(${tilt}) skewX(-14) translate(-110 -110)`}>
      <rect x="-4" y="-4" width="228" height="208" rx="4" fill={frame} />
      <rect width="220" height="200" fill={`url(#${id}-cells)`} />
      <rect width="220" height="200" fill={`url(#${id}-glass)`} />
      <path d="M0 100h220" stroke={variant === 'black' ? '#0b1018' : '#c9ccd1'} stroke-width="2" />
    </g>
  )}

  {category === 'wechselrichter' && (
    <g transform="translate(118 46)">
      <rect x="150" y="14" width="18" height="176" rx="4" fill="#d3d8e0" />
      {Array.from({ length: 9 }).map((_, i) => <rect x="152" y={26 + i * 18} width="22" height="5" rx="2" fill="#c1c7d1" />)}
      <rect width="160" height="204" rx="18" fill={`url(#${id}-metal)`} stroke="#0e1a2c" stroke-opacity="0.08" />
      <rect x="18" y="22" width="124" height="44" rx="10" fill="#1a2c4a" />
      <rect x="28" y="34" width="60" height="5" rx="2.5" fill="#8fb3ea" />
      <rect x="28" y="46" width="38" height="4" rx="2" fill="#ffffff" opacity="0.35" />
      <circle cx="124" cy="44" r="5" fill="#7fd1a1" />
      <path d="M18 92h124M18 104h80" stroke="#0e1a2c" stroke-opacity="0.08" stroke-width="2" stroke-linecap="round" />
      {[34, 58, 82, 106, 130].map((x) => <rect x={x - 6} y="190" width="12" height="20" rx="3" fill="#2a2f38" />)}
    </g>
  )}

  {category === 'speicher' && (
    <g transform="translate(130 36)">
      <rect y="196" width="140" height="22" rx="6" fill="#c9ced8" />
      {[0, 1, 2, 3].map((i) => (
        <g transform={`translate(0 ${148 - i * 50})`}>
          <rect width="140" height="46" rx="10" fill={`url(#${id}-metal)`} stroke="#0e1a2c" stroke-opacity="0.08" />
          <rect x="14" y="18" width="40" height="4" rx="2" fill="#1a2c4a" opacity="0.18" />
          {i === 3 && <rect x="102" y="16" width="24" height="14" rx="4" fill="#1a2c4a" />}
          {i === 3 && <circle cx="114" cy="23" r="3" fill="#8fb3ea" />}
        </g>
      ))}
    </g>
  )}

  {category === 'montagesysteme' && (
    <g transform="translate(46 74)">
      {[0, 1].map((r) => (
        <g transform={`translate(${r * 26} ${r * 70}) skewY(-10)`}>
          <rect width="282" height="22" rx="3" fill={`url(#${id}-metal)`} stroke="#0e1a2c" stroke-opacity="0.12" />
          <path d="M0 7h282M0 15h282" stroke="#0e1a2c" stroke-opacity="0.1" />
          {[54, 148, 238].map((x) => (
            <g transform={`translate(${x} -6)`}>
              <rect width="14" height="34" rx="2" fill="#1a2c4a" />
              <rect x="-4" y="-2" width="22" height="6" rx="2" fill="#2f4a74" />
            </g>
          ))}
        </g>
      ))}
      <path d="M96 120c0 34 10 44 34 44h18" fill="none" stroke="#8d95a3" stroke-width="9" stroke-linecap="round" />
    </g>
  )}

  {category === 'wallboxen' && (
    <g transform="translate(140 34)">
      <rect width="120" height="168" rx="30" fill={`url(#${id}-metal)`} stroke="#0e1a2c" stroke-opacity="0.08" />
      <rect x="14" y="14" width="92" height="140" rx="22" fill="#1a2c4a" />
      <circle cx="60" cy="72" r="22" fill="none" stroke="#8fb3ea" stroke-width="3" />
      <path d="M62 60l-9 14h9l-3 12 10-15h-9z" fill="#8fb3ea" />
      <rect x="42" y="118" width="36" height="5" rx="2.5" fill="#ffffff" opacity="0.3" />
      <path d="M60 168c0 30-8 50-46 52-34 2-40-24-14-30 20-4 46 6 68 6" fill="none" stroke="#1d232c" stroke-width="7" stroke-linecap="round" />
    </g>
  )}

  {category === 'waermepumpen' && (
    <g transform="translate(78 64)">
      <rect y="170" width="244" height="14" rx="4" fill="#c9ced8" />
      <rect width="244" height="166" rx="16" fill={`url(#${id}-metal)`} stroke="#0e1a2c" stroke-opacity="0.08" />
      <circle cx="94" cy="83" r="58" fill="#1a2c4a" />
      {Array.from({ length: 6 }).map((_, i) => <circle cx="94" cy="83" r={14 + i * 8} fill="none" stroke="#ffffff" stroke-opacity="0.14" />)}
      <path d="M94 83c0-26 14-34 24-26M94 83c26 0 34 14 26 24M94 83c0 26-14 34-24 26M94 83c-26 0-34-14-26-24" fill="none" stroke="#8fb3ea" stroke-width="3" stroke-linecap="round" />
      <rect x="176" y="26" width="48" height="114" rx="8" fill="#e9edf3" />
      {Array.from({ length: 8 }).map((_, i) => <rect x="184" y={36 + i * 12} width="32" height="3" rx="1.5" fill="#c5cbd5" />)}
    </g>
  )}

  {category === 'kabel' && (
    <g transform="translate(96 40)">
      <ellipse cx="104" cy="110" rx="96" ry="96" fill="#4d72b0" />
      <ellipse cx="104" cy="110" rx="80" ry="80" fill="#1d232c" />
      {Array.from({ length: 7 }).map((_, i) => <circle cx="104" cy="110" r={76 - i * 6} fill="none" stroke={i % 2 ? '#2a313c' : '#2a5aa8'} stroke-width="3.5" opacity="0.9" />)}
      <ellipse cx="104" cy="110" rx="30" ry="30" fill="#9db8e3" />
      <circle cx="104" cy="110" r="10" fill="#1d3d70" />
      <path d="M180 150c26 16 30 50 54 56" fill="none" stroke="#1d232c" stroke-width="7" stroke-linecap="round" />
      <g transform="translate(228 196) rotate(20)">
        <rect width="34" height="16" rx="5" fill="#1a1d22" />
        <rect x="30" y="4" width="16" height="8" rx="2" fill="#9aa0a8" />
      </g>
    </g>
  )}
</svg>

<style>
  .art { width: 100%; height: auto; display: block; }
</style>

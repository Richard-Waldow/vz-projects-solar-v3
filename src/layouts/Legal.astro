---
import Base from './Base.astro';
interface Props { title: string }
const { title } = Astro.props;
---

<Base title={title}>
  <section class="legal">
    <div class="container legal-inner">
      <span class="eyebrow">Rechtliches</span>
      <h1 class="display">{title}</h1>
      <div class="legal-note">Platzhalter: Dieser Text muss vor Veröffentlichung rechtlich geprüft und vervollständigt werden.</div>
      <div class="legal-body"><slot /></div>
    </div>
  </section>
</Base>

<style>
  .legal { padding: clamp(132px, 15vw, 176px) 0 var(--section); }
  .legal-inner { max-width: 860px; display: grid; gap: 1.6rem; justify-items: start; }
  .legal .display { font-size: clamp(2.8rem, 6vw, 5rem); }
  .legal-note { padding: 0.9rem 1.2rem; border-radius: 1rem; background: var(--sun-3); color: #173a6e; font-size: 0.88rem; }
  .legal-body { width: 100%; color: var(--muted); }
  .legal-body :global(h2) { margin: 2.2rem 0 0.6rem; font-family: var(--f-display); font-size: 1.7rem; font-weight: 600; color: var(--ink); }
  .legal-body :global(p) { margin: 0 0 0.8rem; max-width: 70ch; }
</style>

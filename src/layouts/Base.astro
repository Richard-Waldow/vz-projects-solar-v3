---
import { u } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RequestDrawer from '../components/RequestDrawer.astro';

interface Props { title: string; description?: string }
const {
  title,
  description = 'VZ Projects Solar GmbH: PV-Großhandel für Stadtwerke, Energieversorger, Projektentwickler und Fachhandwerk. Solarmodule, Wechselrichter, Speicher, Montagesysteme, Wallboxen, Wärmepumpen und Kabel.',
} = Astro.props;
const fullTitle = title === 'Start' ? 'VZ Projects Solar · PV-Großhandel für die Energiewende' : `${title} · VZ Projects Solar`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Entwurf: vor dem Livegang entfernen -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@300..700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:ital,wght@1,600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <RequestDrawer />

    <script>
      // Weiche Einblendung beim Scrollen
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Kennzahlen hochzählen (einmalig, deutsches Zahlenformat bleibt erhalten)
      const countEls = document.querySelectorAll<HTMLElement>('[data-countup]');
      if (countEls.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const run = (el: HTMLElement) => {
          const src = el.textContent!.trim();
          const decimals = src.includes(',') ? src.split(',')[1].length : 0;
          const target = parseFloat(src.replace(/\./g, '').replace(',', '.'));
          const fmt = new Intl.NumberFormat('de-DE', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 1200);
            el.textContent = t < 1 ? fmt.format(target * (1 - Math.pow(1 - t, 4))) : src;
            if (t < 1) requestAnimationFrame(tick);
          };
          el.textContent = fmt.format(0);
          requestAnimationFrame(tick);
        };
        const co = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); co.unobserve(e.target); } }),
          { threshold: 0.4 },
        );
        countEls.forEach((el) => co.observe(el));
      }
    </script>

    <style>
      main { position: relative; z-index: 2; }
      .skip { position: fixed; left: 16px; top: -60px; z-index: 100; padding: 10px 16px; border-radius: 999px; background: var(--ink); color: var(--white); transition: top 0.3s var(--ease); }
      .skip:focus { top: 16px; }
    </style>
  </body>
</html>

---
import Legal from '../layouts/Legal.astro';
import { company } from '../data/site';
---

<Legal title="Impressum">
  <h2>Angaben gemäß § 5 DDG</h2>
  <p>{company.name}<br />{company.street}<br />{company.city}</p>
  <h2>Vertreten durch</h2>
  <p>{company.ceo}, Geschäftsführer</p>
  <h2>Kontakt</h2>
  <p>Telefon: {company.phone}<br />E-Mail: {company.email}</p>
  <h2>Registereintrag</h2>
  <p>{company.register}</p>
  <h2>Umsatzsteuer-ID</h2>
  <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG: {company.vatId}</p>
  <h2>Verantwortlich für den Inhalt</h2>
  <p>{company.ceo}, Anschrift wie oben</p>
</Legal>

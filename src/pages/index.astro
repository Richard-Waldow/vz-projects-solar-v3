  .final-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.32; filter: grayscale(0.4); }
  .final-glow { position: absolute; inset: 0; background: radial-gradient(50% 60% at 50% 0%, rgba(59, 120, 208, 0.45), transparent 70%), linear-gradient(180deg, rgba(7, 19, 40, 0.2), var(--deep) 96%); }
  .final-inner { position: relative; display: grid; justify-items: center; gap: 1.2rem; max-width: 1100px; margin: 0 auto; }
  .final-inner .lead { max-width: 46ch; color: rgba(255, 255, 255, 0.72); }
  .final-inner .hero-ctas { animation: none; }
  .final-sun { width: 44px; height: 44px; color: var(--sun-2); animation: spin 40s linear infinite; }
  .contact-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; max-width: 1100px; padding: 48px var(--gutter) 0; }
  .contact-strip > div { display: grid; gap: 0.25rem; padding: 20px 22px; border-radius: 20px; background: var(--tile); font-size: 0.95rem; font-weight: 500; }
  .contact-strip .mono { font-family: var(--f-ui); color: var(--muted); font-size: 0.78rem; font-weight: 400; }
  .contact-strip a:hover { color: #1f4a8a; }

  @media (max-width: 1000px) {
    .sol-grid, .eco-grid, .range-grid { grid-template-columns: 1fr 1fr; }
    .how-head, .quality, .reach-grid { grid-template-columns: 1fr; }
    .how-panel { grid-template-columns: 1fr; }
    .how-visual { min-height: 440px; }
    .seg-body { grid-template-columns: 1fr; }
    .contact-strip { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 700px) {
    .hero-media { aspect-ratio: 4 / 5; }
    .hero-stats { grid-template-columns: 1fr 1fr; gap: 16px; }
    .ch-grid { grid-template-columns: 1fr; }
    .ch-lines, .ch-nodes { display: none; }
    .sol-grid { grid-template-columns: 1fr; }
    .sol-img { aspect-ratio: 16 / 10; }
    .eco-grid { grid-template-columns: 1fr; }
    .eco-cell { min-height: 0; }
    .tab { padding: 10px 8px; font-size: 0.85rem; }
    .tab .mono { display: none; }
    .seg-imgs { grid-template-columns: 1fr; }
    .seg-imgs div + div { display: none; }
    .seg-points { grid-template-columns: 1fr; }
    .rc-body h3 { font-size: 1rem; }
    .rc-body { padding: 0 16px 18px; }
    .rc-cta { padding: 20px; }
    .rc-cta h3 { font-size: 1.1rem; }
    .msg { font-size: 0.76rem; }
    .how-text { padding: 28px 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .w > span, .hero-media { animation: none; }
    .hero-media { transform: none; }
    .ch-flow { display: none; }
  }
</style>

<script>
  // Hero: Videokachel zieht sich beim Scrollen auf volle Breite auf (nur transform)
  const stage = document.querySelector<HTMLElement>('[data-stage] .hero-media');
  if (stage && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;
    const grow = () => {
      queued = false;
      const r = stage.parentElement!.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight * 0.9)));
      stage.style.setProperty('--s', String(0.92 + 0.08 * p));
    };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(grow); } }, { passive: true });
    grow();
  }

  // Manifest: Wörter leuchten nacheinander auf, gekoppelt an den Scrollfortschritt
  const scrub = document.querySelector<HTMLElement>('[data-scrub]');
  if (scrub) {
    const words = [...scrub.querySelectorAll<HTMLElement>('.mw')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) words.forEach((w) => w.classList.add('on'));
    else {
      let active = false;
      let ticking = false;
      const update = () => {
        ticking = false;
        const r = scrub.getBoundingClientRect();
        const vh = window.innerHeight;
        const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height * 0.9)));
        const lit = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('on', i < lit));
      };
      const onScroll = () => { if (active && !ticking) { ticking = true; requestAnimationFrame(update); } };
      new IntersectionObserver(([e]) => { active = e.isIntersecting; if (active) update(); }).observe(scrub);
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  // Tabs mit automatischem Weiterschalten (Fortschrittsbalken), pausiert außerhalb des Viewports
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const auto = root.dataset.tabs === 'how' && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    const show = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === current)); t.tabIndex = k === current ? 0 : -1; });
      panels.forEach((p, k) => (p.hidden = k !== current));
      if (focus) tabs[current].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') show(current + 1, true);
        if (e.key === 'ArrowLeft') show(current - 1, true);
      });
      if (auto) t.querySelector('.tab-bar i')?.addEventListener('animationend', () => show(current + 1));
    });
    show(0);
    if (auto) {
      root.classList.add('is-paused');
      new IntersectionObserver(([e]) => root.classList.toggle('is-paused', !e.isIntersecting), { threshold: 0.35 }).observe(root);
    } else {
      root.querySelectorAll<HTMLElement>('.tab-bar').forEach((b) => (b.style.display = 'none'));
    }
  });

  // Hintergrundvideos nur abspielen, wenn sichtbar (spart Akku und Daten)
  document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.pause(); return; }
    new IntersectionObserver(([e]) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); }).observe(v);
  });
</script>

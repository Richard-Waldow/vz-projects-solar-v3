---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductArt from '../components/ProductArt.astro';
import BrandLogo from '../components/BrandLogo.astro';
import GermanyMap from '../components/GermanyMap.astro';
import { categories, products, productsByCategory } from '../data/products';
import { brands } from '../data/brands';
import { company, stats, showPlaceholderNote } from '../data/site';

const heroWords = 'Ihr PV-Großhandel für Projekte.'.split(' ');
const heroAccent = 'Schnell. Verlässlich. Transparent.'.split(' ');

const challenges = [
  { t: 'Zersplittert', d: 'Module hier, Wechselrichter dort, Unterkonstruktion woanders: Jede Komponente ist ein eigener Einkauf mit eigenem Ansprechpartner.' },
  { t: 'Intransparent', d: 'Verfügbarkeiten, Datenblätter und Konditionen sind schwer vergleichbar. Wer was liefern kann, zeigt sich oft erst spät.' },
  { t: 'Langsam', d: 'Angebote ziehen sich, Alternativen fehlen und Projekte warten auf Material, statt gebaut zu werden.' },
];

const manifesto = [
  ['Wir', 'bauen', 'den', 'PV-Großhandel,', 'den', 'Projekte', 'brauchen:'],
  ['*ein', '*Ansprechpartner', '*für', '*das', '*komplette', '*Material,'],
  ['verbindliche', 'Projektangebote', 'und', '*Logistik', '*bis', '*zur', '*Baustelle.'],
  ['Damit', 'Stadtwerke,', 'Projektierer', 'und', 'Solarteure', '*planen', '*können,'],
  ['statt', 'Material', 'hinterherzutelefonieren.'],
].flat();

const solutions = [
  { t: 'Projektkonditionen', d: 'Verbindliche Angebote für Container- und Projektmengen. Per Telefon, E-Mail, WhatsApp oder direkt aus Ihrer Stückliste.', img: '/img/utility.jpg' },
  { t: 'Herstellerunabhängig', d: `${brands.length} Marken im Sortiment. Wir empfehlen, was zum Projekt passt, und bieten Alternativen, wenn ein Hersteller knapp wird.`, img: '/img/field.jpg' },
  { t: 'Logistik bis zur Baustelle', d: 'Direkt ab Hersteller- und Partnerlager: palettiert, avisiert und auf Wunsch in Teilabrufen.', img: '/img/roof.jpg' },
  { t: 'Technische Prüfung', d: 'Wir prüfen Stücklisten auf Kompatibilität, damit Modul, Wechselrichter, Speicher und Unterkonstruktion zusammenpassen.', img: '/img/installer.jpg' },
];

const brandGroups = categories.map((c) => ({
  c,
  brands: brands.filter((b) => products.some((p) => p.brand === b.id && p.category === c.id)),
}));

const steps = [
  { k: 'anfrage', t: 'Anfrage', n: '01', h: 'Bedarf schildern', d: 'Mengen, Projekt und Zeitfenster per Telefon, E-Mail, WhatsApp, Stückliste oder über den Produktkatalog. Wir strukturieren die Anfrage und klären offene Punkte.' },
  { k: 'angebot', t: 'Angebot', n: '02', h: 'Verbindliches Angebot erhalten', d: 'Positionen, Konditionen und geprüfte Kompatibilität in einem Angebot. Wo sinnvoll, mit gleichwertigen Alternativen anderer Hersteller.' },
  { k: 'lieferung', t: 'Lieferung', n: '03', h: 'Liefern, abrufen, nachbestellen', d: 'Avisierte Lieferung auf die Baustelle, ins Lager oder in Teilabrufen. Jede Bestellung macht die nächste schneller, weil wir Ihre Standards kennen.' },
];

const segments = [
  {
    k: 'evu', t: 'Stadtwerke & EVU',
    h: 'PV-Pakete für Ihr Endkundengeschäft',
    d: 'Standardisierte Anlagenpakete, Rahmenverträge mit planbaren Konditionen und ein fester Ansprechpartner, damit Ihr PV-Angebot skaliert.',
    points: ['Rahmenverträge & Abrufmengen', 'Paketierung nach Ihrem Portfolio', 'Herstellerunabhängige Beratung', 'Ein Ansprechpartner für alles'],
    imgs: ['/img/commercial.jpg', '/img/aerial.jpg'],
  },
  {
    k: 'epc', t: 'Projektentwickler & EPC',
    h: 'Containerware für Freifläche und Gewerbedach',
    d: 'Module, Wechselrichter, Unterkonstruktion und Kabel projektbezogen kalkuliert, inklusive Alternativen, wenn ein Hersteller knapp wird.',
    points: ['Projektpreise ab Containermenge', 'Stücklistenprüfung & Kompatibilität', 'Abgestimmte Lieferabrufe', 'Dokumentation & Zertifikate'],
    imgs: ['/img/utility.jpg', '/img/field.jpg'],
  },
  {
    k: 'handwerk', t: 'Solarteure & Handwerk',
    h: 'Alles fürs Dach, aus einer Hand',
    d: 'Vom Modul bis zum MC4-Stecker: abgestimmte Komponenten für Wohn- und Gewerbeanlagen, inklusive Speicher, Wallbox und Wärmepumpe.',
    points: ['Komplettpakete fürs Einfamilienhaus', 'Speicher-, Wallbox- & WP-Kombis', 'Lieferung direkt zur Baustelle', 'Bald: Online-Shop'],
    imgs: ['/img/installer.jpg', '/img/roof.jpg'],
  },
];

const quality = [
  { k: 'Herkunft', t: 'Original-Herstellerware', d: 'Bezug direkt bei Herstellern und autorisierten Distributionspartnern, mit voller Herstellergarantie.' },
  { k: 'Normen', t: 'IEC 61215 · IEC 61730 · VDE-AR-N 4105 / 4110', d: 'Zertifizierte Komponenten für Netzanschluss und Förderfähigkeit in Deutschland.' },
  { k: 'Dokumente', t: 'Datenblätter & Zertifikate', d: 'Konformitätserklärungen, Garantieunterlagen und Datenblätter zu jeder Lieferung.' },
];

const regions = [
  { r: 'Nord', c: ['Hamburg', 'Bremen', 'Kiel', 'Rostock'] },
  { r: 'Ost', c: ['Berlin', 'Leipzig', 'Dresden', 'Magdeburg'] },
  { r: 'West', c: ['Köln', 'Dortmund', 'Hannover', 'Frankfurt'] },
  { r: 'Süd', c: ['München', 'Stuttgart', 'Nürnberg', 'Freiburg'] },
];
---

<Base title="Start">
  <!-- HERO: Headline zentriert, darunter das Video als Kachel, die sich beim Scrollen aufzieht -->
  <section class="hero">
    <div class="hero-inner">
      <span class="eyebrow hero-eyebrow">PV-Großhandel für Projekte</span>
      <h1 class="display hero-title" aria-label="Ihr PV-Großhandel für Projekte. Schnell, verlässlich, transparent.">
        <span class="hero-line">{heroWords.map((w, i) => <span class="w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>)}</span>
        <span class="hero-line">{heroAccent.map((w, i) => <span class="w" aria-hidden="true"><span style={`--i:${heroWords.length + i}`}><em>{w}</em></span></span>)}</span>
      </h1>
      <p class="hero-lead">Module, Wechselrichter, Speicher und alles, was dazugehört. Verbindliche Projektangebote, herstellerunabhängige Beratung und Lieferung bis auf die Baustelle.</p>
      <div class="hero-ctas">
        <a href={u('/anfrage')} class="btn">Angebot anfragen</a>
        <a href={u('/produkte')} class="link-arrow">Sortiment ansehen <Icon name="arrow-right" /></a>
      </div>
    </div>

    <div class="hero-stage" data-stage>
      <div class="hero-media">
        <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster={u('/video/hero-poster.jpg')} aria-hidden="true">
          <source src={u('/video/hero.mp4')} type="video/mp4" />
        </video>
        <div class="hero-shade" aria-hidden="true"></div>
        <dl class="hero-stats">
          {stats.map((s) => (
            <div>
              <dd><span class="countup"><span aria-hidden="true">{s.value}</span><span data-countup>{s.value}</span></span><span class="unit">{s.unit}</span></dd>
              <dt>{s.label}</dt>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
  {showPlaceholderNote && <p class="placeholder-note hero-note">Kennzahlen sind Beispielwerte für die Präsentation.</p>}

  <!-- HERAUSFORDERUNG -->
  <div class="gridband"></div>
  <section class="challenge">
    <h2 class="h2 reveal">Die Herausforderung heute</h2>
    <div class="ch-grid">
      {challenges.map((c, i) => (
        <article class="ch reveal" style={`--d:${i * 90}ms`}>
          <div class:list={['vig', `vig-${i}`]} aria-hidden="true">
            {i === 0 && (
              <div class="vig-card">
                <span class="vig-title">Herstellermarkt</span>
                <span class="vig-sub"><span class="spin"></span>Verbinde Lieferanten …</span>
                <span class="vig-rot"><span>Modul · Distributor A</span><span>Wechselrichter · Händler B</span><span>Speicher · Importeur C</span></span>
              </div>
            )}
            {i === 1 && (
              <div class="vig-card">
                <span class="vig-title">Produkt</span>
                <span class="vig-sub"><span class="spin"></span>Suche Datenblatt …</span>
                <span class="vig-skel"><i></i><i></i><i></i></span>
              </div>
            )}
            {i === 2 && (
              <div class="vig-chips">
                <span><span class="spin"></span>Preis</span>
                <span><span class="spin"></span>Verfügbarkeit</span>
              </div>
            )}
          </div>
          <h3 class="h3">{c.t}</h3>
          <p>{c.d}</p>
        </article>
      ))}
    </div>
    <svg class="ch-lines" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M200 0V60H1000V0M600 60V120" class="ch-path" />
      <path d="M200 0V60H1000V0M600 60V120" class="ch-flow" />
    </svg>
    <div class="ch-nodes" aria-hidden="true"><span class="node" style="left:16.66%"></span><span class="node" style="left:50%"></span><span class="node" style="left:83.33%"></span></div>
  </section>

  <!-- MANIFEST: Wörter leuchten beim Scrollen auf -->
  <section class="manifest" data-scrub>
    <div class="mf-mark" aria-hidden="true"><span>v<span>Z</span></span></div>
    <p class="mf-text">
      {manifesto.map((w) => w.startsWith('*') ? <span class="mw hl">{w.slice(1)} </span> : <span class="mw">{w} </span>)}
    </p>
  </section>
  <div class="gridband"></div>

  <!-- LÖSUNG -->
  <section class="solution">
    <div class="sec-head reveal">
      <span class="eyebrow">Lösung</span>
      <h2 class="h2">Ein Großhändler für<br />das ganze Projekt</h2>
    </div>
    <div class="sol-grid">
      {solutions.map((s, i) => (
        <article class="sol reveal" style={`--d:${i * 80}ms`}>
          <div class="sol-img"><img src={u(s.img)} alt="" loading="lazy" /></div>
          <div class="sol-body">
            <h3 class="h3">{s.t}</h3>
            <p>{s.d}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ÖKOSYSTEM: Hersteller je Kategorie -->
  <section class="eco">
    <div class="sec-head reveal">
      <h2 class="h2">Unser Herstellernetzwerk</h2>
      <p class="lead">Tier-1-Module, Wechselrichter, Speicher und Systemtechnik. Bezogen direkt bei Herstellern und autorisierten Distributionspartnern.</p>
    </div>
    <div class="eco-grid">
      {brandGroups.map((g) => (
        <a href={u(`/produkte/${g.c.id}`)} class="eco-cell reveal">
          <span class="mono eco-label">{g.c.name}</span>
          <span class="eco-logos">{g.brands.map((b) => <span class="eco-logo"><BrandLogo id={b.id} mono /></span>)}</span>
        </a>
      ))}
      <a href={u('/hersteller')} class="eco-cell eco-all reveal">
        <span class="mono eco-label">{brands.length} Hersteller</span>
        <span class="eco-cta">Alle Hersteller ansehen <Icon name="arrow-right" /></span>
      </a>
    </div>
  </section>
  <div class="gridband"></div>

  <!-- SO FUNKTIONIERT'S: Tabs mit Fortschrittsbalken -->
  <section class="how" data-tabs="how">
    <div class="how-head">
      <div class="reveal">
        <span class="eyebrow">So funktioniert's</span>
        <h2 class="h2">Ein Ablauf von der<br />Anfrage bis zur Baustelle</h2>
      </div>
      <div class="how-side reveal" style="--d:100ms">
        <p class="lead">VZ Projects begleitet jede Bestellung von der ersten Anfrage bis zur Lieferung. Sie haben einen Ansprechpartner, wir koordinieren Hersteller, Logistik und Dokumentation.</p>
        <a href={u('/anfrage')} class="btn">Jetzt anfragen <span class="btn-icon"><Icon name="arrow-up-right" /></span></a>
      </div>
    </div>

    <div class="tabs" role="tablist" aria-label="Ablauf">
      {steps.map((s, i) => (
        <button type="button" role="tab" class="tab" id={`how-tab-${s.k}`} aria-controls={`how-panel-${s.k}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
          <span>{s.t}</span><span class="mono">{s.n}</span>
          <span class="tab-bar" aria-hidden="true"><i></i></span>
        </button>
      ))}
    </div>

    <div class="how-body">
      {steps.map((s, i) => (
        <div class="how-panel" role="tabpanel" id={`how-panel-${s.k}`} aria-labelledby={`how-tab-${s.k}`} hidden={i !== 0} data-panel={i}>
          <div class="how-text">
            <span class="mono how-n">{s.n} / 03</span>
            <h3 class="h3">{s.h}</h3>
            <p>{s.d}</p>
          </div>
          <div class="how-visual">
            <img src={u(i === 0 ? '/img/installer.jpg' : i === 1 ? '/img/commercial.jpg' : '/img/utility.jpg')} alt="" loading="lazy" />
            {i === 0 && (
              <div class="chat" aria-hidden="true">
                <p class="msg msg--in" style="--k:0">Hallo, habt ihr Module und Wechselrichter für 1,2 MWp Freifläche in Brandenburg?</p>
                <p class="msg msg--out" style="--k:1"><span class="msg-from">VZ Projects</span>Ja. Zwei Varianten: Trina Vertex N bifazial oder JA DeepBlue 4.0, jeweils mit Sungrow SG110CX. Schicken Sie uns gern die Stückliste.</p>
                <p class="msg msg--in" style="--k:2">Stückliste kommt per Mail. Unterkonstruktion bitte mit anbieten.</p>
                <p class="msg msg--out" style="--k:3"><span class="msg-from">VZ Projects</span>Gern, K2 oder Schletter. Wir prüfen die Kompatibilität und melden uns mit dem Angebot.</p>
              </div>
            )}
            {i === 1 && (
              <div class="quote" aria-hidden="true">
                <div class="q-head"><span class="mono">Angebot VZ-2026-0412</span><span class="q-badge"><Icon name="check" /> Verbindlich</span></div>
                <ul>
                  <li style="--k:0"><span>2.016 ×</span>Trina Vertex N 620 Wp, bifazial</li>
                  <li style="--k:1"><span>10 ×</span>Sungrow SG110CX</li>
                  <li style="--k:2"><span>1 ×</span>K2 TerraGround, Freifläche</li>
                  <li style="--k:3"><span>1 ×</span>Kabel & MC4-Stecker lt. Stückliste</li>
                </ul>
                <div class="q-foot"><span class="mono">Kompatibilität geprüft</span><Icon name="check" /></div>
              </div>
            )}
            {i === 2 && (
              <div class="track" aria-hidden="true">
                <div class="q-head"><span class="mono">Lieferung · Projekt Brandenburg</span></div>
                <ol>
                  <li class="done" style="--k:0"><i></i>Auftrag bestätigt</li>
                  <li class="done" style="--k:1"><i></i>Ware beim Hersteller kommissioniert</li>
                  <li class="now" style="--k:2"><i></i>Unterwegs · Lkw 3 von 6</li>
                  <li style="--k:3"><i></i>Anlieferung Baustelle, avisiert</li>
                </ol>
                <div class="track-bar"><i></i></div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FÜR WEN -->
  <div class="gridband"></div>
  <section class="who" data-tabs="who">
    <div class="sec-head reveal">
      <span class="eyebrow">Für Energieversorger, Projektierer & Handwerk</span>
      <h2 class="h2">Ein Lieferant, der Ihr<br />Wachstum mitträgt</h2>
      <p class="lead">Verfügbarkeit, Planbarkeit und ein Ansprechpartner, der Ihr Geschäft versteht.</p>
    </div>
    <div class="seg-tabs" role="tablist" aria-label="Kundengruppen">
      {segments.map((s, i) => (
        <button type="button" role="tab" class="seg-tab" id={`who-tab-${s.k}`} aria-controls={`who-panel-${s.k}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{s.t}</button>
      ))}
    </div>
    {segments.map((s, i) => (
      <div class="seg" role="tabpanel" id={`who-panel-${s.k}`} aria-labelledby={`who-tab-${s.k}`} hidden={i !== 0} data-panel={i}>
        <div class="seg-imgs">{s.imgs.map((src) => <div><img src={u(src)} alt="" loading="lazy" /></div>)}</div>
        <div class="seg-body">
          <div class="seg-copy">
            <h3 class="h3">{s.h}</h3>
            <p>{s.d}</p>
          </div>
          <ul class="seg-points">{s.points.map((p) => <li><Icon name="check" />{p}</li>)}</ul>
        </div>
      </div>
    ))}
    <div class="who-cta"><a href={u('/loesungen')} class="btn btn--ghost">Lösungen im Detail <span class="btn-icon"><Icon name="arrow-right" /></span></a></div>
  </section>

  <!-- SORTIMENT -->
  <div class="gridband"></div>
  <section class="range">
    <div class="range-head">
      <div class="reveal">
        <span class="eyebrow">Sortiment</span>
        <h2 class="h2">{products.length} Produktlinien in<br />7 Kategorien</h2>
      </div>
      <a href={u('/produkte')} class="btn btn--ghost reveal">Zum Produktkatalog <span class="btn-icon"><Icon name="arrow-right" /></span></a>
    </div>
    <div class="range-grid">
      {categories.map((c, i) => {
        const list = productsByCategory(c.id);
        const bs = [...new Set(list.map((p) => p.brand))].length;
        return (
          <a href={u(`/produkte/${c.id}`)} class="rc reveal" style={`--d:${(i % 4) * 70}ms`}>
            <div class="rc-art"><ProductArt category={c.id} seed={i} cover /></div>
            <div class="rc-body">
              <span class="mono rc-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.name}</h3>
              <span class="mono rc-meta">{list.length} Produktlinien · {bs} Hersteller</span>
            </div>
            <span class="rc-go"><Icon name="arrow-up-right" /></span>
          </a>
        );
      })}
      <a href={u('/anfrage')} class="rc rc-cta reveal" style="--d:210ms">
        <span class="mono">Nicht dabei?</span>
        <h3>Wir beschaffen auch außerhalb des Katalogs.</h3>
        <span class="link-arrow">Individuell anfragen <Icon name="arrow-right" /></span>
      </a>
    </div>
  </section>

  <!-- QUALITÄT -->
  <div class="gridband"></div>
  <section class="quality">
    <div class="q-copy reveal">
      <span class="eyebrow">Qualität & Compliance</span>
      <h2 class="h2">Zertifizierte Ware,<br />saubere Unterlagen</h2>
      <p class="lead">Wir prüfen Zertifikate, Normen und Garantiebedingungen, bevor Ware auf Ihre Baustelle geht. Damit Netzanschluss, Abnahme und Förderung ohne Rückfragen laufen.</p>
    </div>
    <ul class="q-cells">
      {quality.map((q, i) => (
        <li class="reveal" style={`--d:${i * 80}ms`}>
          <span class="mono">{q.k}</span>
          <strong>{q.t}</strong>
          <span>{q.d}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- KARTE -->
  <div class="gridband"></div>
  <section class="reach">
    <div class="sec-head reveal">
      <span class="eyebrow">Lieferung</span>
      <h2 class="h2">Bundesweit liefern,<br />regional denken</h2>
      <p class="lead">Direkt ab Hersteller- und Partnerlagern auf Ihre Baustelle, in alle 16 Bundesländer.</p>
    </div>
    <div class="reach-grid">
      <div class="reach-map reveal"><GermanyMap /></div>
      <div class="reach-list">
        {regions.map((r, i) => (
          <div class="reveal" style={`--d:${i * 70}ms`}>
            <span class="mono">{r.r}</span>
            <ul>{r.c.map((c) => <li>{c}</li>)}</ul>
          </div>
        ))}
        <p class="placeholder-note">Beispielhafte Lieferregionen.</p>
      </div>
    </div>
  </section>

  <!-- SHOP-HINWEIS -->
  <div class="gridband"></div>
  <section class="shopline">
    <div class="reveal">
      <span class="eyebrow">Online-Shop · Bald</span>
      <h2 class="h3">Für Solarteure: bestellen mit Projektkonditionen, rund um die Uhr.</h2>
    </div>
    <a href={u('/shop')} class="btn btn--ghost reveal">Benachrichtigen lassen <span class="btn-icon"><Icon name="arrow-up-right" /></span></a>
  </section>

  <!-- ABSCHLUSS-CTA mit Lichtkegel -->
  <section class="final on-dark">
    <video class="final-video" autoplay muted loop playsinline preload="none" poster={u('/video/topdown-poster.jpg')} aria-hidden="true">
      <source src={u('/video/topdown.mp4')} type="video/mp4" />
    </video>
    <div class="final-glow" aria-hidden="true"></div>
    <div class="final-inner reveal">
      <svg class="final-sun" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="7.2" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
        <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="20" y1="2.5" x2="20" y2="8"></line><line x1="20" y1="32" x2="20" y2="37.5"></line>
          <line x1="2.5" y1="20" x2="8" y2="20"></line><line x1="32" y1="20" x2="37.5" y2="20"></line>
          <line x1="7.6" y1="7.6" x2="11.5" y2="11.5"></line><line x1="28.5" y1="28.5" x2="32.4" y2="32.4"></line>
          <line x1="7.6" y1="32.4" x2="11.5" y2="28.5"></line><line x1="28.5" y1="11.5" x2="32.4" y2="7.6"></line>
        </g>
      </svg>
      <h2 class="h2">Ihr nächstes Projekt.<br />Ein Ansprechpartner.</h2>
      <p class="lead">Schicken Sie uns Ihre Stückliste oder rufen Sie an. {company.ceo} und das Team melden sich mit einem verbindlichen Angebot.</p>
      <div class="hero-ctas">
        <a href={u('/anfrage')} class="btn">Angebot anfragen <span class="btn-icon"><Icon name="arrow-up-right" /></span></a>
        <a href={company.linkedin} target="_blank" rel="noopener" class="btn btn--ghost">{company.ceo} auf LinkedIn <span class="btn-icon"><Icon name="linkedin" /></span></a>
      </div>
    </div>
  </section>
